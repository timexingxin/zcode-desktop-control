{
  "name": "zcode-desktop-control-monorepo",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Local-first desktop automation for AI agents, with first-class ZCode and MCP integration.",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --filter \"./packages/*\" run build",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs",
    "test:e2e:real": "pnpm run doctor --require-real-gui && node scripts/run-tests.mjs --real-gui",
    "typecheck": "pnpm --recursive --filter \"./packages/*\" run typecheck",
    "lint": "node scripts/lint.mjs",
    "clean": "pnpm --recursive --filter \"./packages/*\" run clean 2>/dev/null || true",
    "cua": "node packages/cli/bin/cua.mjs",
    "doctor": "node packages/cli/bin/cua.mjs doctor",
    "smoke-test": "node scripts/smoke-test.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "benchmark": "node scripts/benchmark-compression.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0"
}
